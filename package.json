{
  "name": "vault-orb",
  "productName": "Vault Orb",
  "version": "0.2.3",
  "description": "A voice companion for your Obsidian vault",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "build:native": "node scripts/build-native.cjs",
    "start": "electron .",
    "test": "node scripts/build-recurring.cjs --check && node --test test/*.test.cjs",
    "prepackage": "npm run build:recurring && npm run build:native && npm run build:maps",
    "package": "electron-packager . 'Vault Orb' --platform=darwin --arch=arm64 --out=dist --overwrite --icon=assets/icon.icns --app-bundle-id=app.vaultorb.desktop --extend-info=assets/Info.plist --ignore='^/(dist|test|screenshots|scripts|vault-example|.claude|agent.cjs|package-lock.json)' --extra-resource=native/orb-shortcut.node --extra-resource=native/orb-location.node",
    "build:recurring": "node scripts/build-recurring.cjs",
    "check:recurring": "node scripts/build-recurring.cjs --check",
    "build:maps": "node scripts/build-maps.cjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "ical.js": "^2.2.1",
    "maplibre-gl": "6.11.2",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^41.0.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
