filters:
  and:
    - file.inFolder("6. Life Admin/Places")
    - file.ext == "md"
    - note.type == "place"
properties:
  file.name:
    displayName: Place
  note.category:
    displayName: Category
  note.location:
    displayName: Location
  note.latitude:
    displayName: Latitude
  note.longitude:
    displayName: Longitude
  note.website:
    displayName: Website
views:
  - type: table
    name: All
    order: [file.name, category, location, website, latitude, longitude]
  - type: table
    name: By category
    groupBy:
      property: category
      direction: ASC
    order: [file.name, category, location, website, latitude, longitude]
  - type: table
    name: With coordinates
    filters:
      and:
        - '!note.latitude.isEmpty()'
        - '!note.longitude.isEmpty()'
    order: [file.name, category, location, latitude, longitude, website]
